# Función: Es tu colección de peticiones (el equivalente a las colecciones de Postman/Bruno).
# Contiene los métodos (GET, POST, etc.), los encabezados, los cuerpos en JSON y
# los scripts de respuesta (los bloques > {% ... %}) en JavaScript para automatizar flujos como la captura de tokens.

# (Colección de peticiones y scripts - Sí se sube a Git)

### 1. Autenticación (Obtener Token Dinámico)
# Consume {{base_url}} del archivo público
POST {{base_url}}/api/{{version}}/auth/login
Content-Type: application/json

{
  "client_id": "usuario_sistema",
  "client_secret": "password_insegura_de_prueba"
}

> {%
    // Script de respuesta: Validamos el estatus de la red
    client.test("Login exitoso en el Servidor", function() {
        client.assert(response.status === 200, "El servidor rechazó las credenciales.");
    });

    // Extraemos el token del cuerpo de la respuesta JSON
    let token = response.body.access_token;

    // Lo inyectamos en la memoria volátil global bajo el nombre 'api_token'
    // Esto sobreescribe temporalmente cualquier JSON físico por seguridad
    client.global.set("api_token", token);
    
    client.log("Transmisión exitosa: 'api_token' guardado en la memoria del IDE.");
%}


### 2. Consulta Protegida (Usa el Token en Memoria o el del JSON Privado)
# Si corriste la petición 1, 'api_token' se leerá de la memoria global del IDE.
# Si no la has corrido, el IDE buscará 'api_token' en tu archivo privado local.
GET {{base_url}}/api/{{version}}/transactions/summary
Authorization: Bearer {{api_token}}
Accept: application/json