# (El reemplazo del .env estilo Java)
# En el mundo de Java, en lugar de un .env plano, se suele usar un archivo
# de propiedades de desarrollo local que se inyecta en el arranque. 
# Este ejemplo te sirve si tu backend Java va a conectarse a una base de datos o necesita una clave:

# Copiar este archivo como 'application-local.yml' y rellenar las credenciales
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/mi_base_java
    username: usuario_local
    password: TU_PASSWORD_LOCAL_DE_POSTGRES
  security:
    jwt:
      secret-key: TU_LLAVE_SECRETA_LOCAL_PARA_FIRMAR_TOKENS
